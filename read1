balance = 50000

print("1. Check balance ")
print("2. Deposit ")
print("3. Withdraw ")
print("4. Exit")

choice = int(input("Enter choice:"))

if choice == 1:
  print("Your balance is:",balance)

elif choice == 2:
  amount = float(input("Enter amount:"))
  balance += amount
  print("Updated balance is:",balance)

elif choice == 3:
  amount = float(input("Enter amount:"))
  if amount <= balance:
    balance -= amount
    print("Updated balance is:",balance)
  else:
    print("Insufficient balance")
