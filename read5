class Bank:
  def __init__ (self,amount):
    self.amount = amount
  def getbalance(self):
    print("Current Balance is",self.amount)
  def getdeposit(self,amount):
    self.amount += amount
  def withdraw(self,amount):
    self.amount -= amount
# Create Object
myobj = Bank(10000)
myobj.getbalance()
myobj.getdeposit(5000)
myobj.getbalance()
myobj.withdraw(200000)
myobj.getbalance()
